# Sounds played by notify-sound.sh.
# Value: path to any audio file, or "none" to mute that event.
# Built-in macOS sounds: /System/Library/Sounds/
#   Basso, Blow, Bottle, Frog, Funk, Glass, Hero, Morse, Ping, Pop, Purr, Sosumi, Submarine, Tink

# Claude asks you a question
CLAUDE_SOUND_QUESTION=/System/Library/Sounds/Glass.aiff

# Claude asks permission to run a tool
CLAUDE_SOUND_PERMISSION=/System/Library/Sounds/Ping.aiff

# Claude has finished responding
CLAUDE_SOUND_STOP=/System/Library/Sounds/Hero.aiff

# Claude has been waiting for your input (only if you enabled the Notification hook)
CLAUDE_SOUND_NOTIFY=/System/Library/Sounds/Glass.aiff

# Show a macOS notification banner too (1 = on, 0 = off)
CLAUDE_NOTIFY_BANNER=1

# Linux example:
# CLAUDE_SOUND_QUESTION=/usr/share/sounds/freedesktop/stereo/message.oga
# CLAUDE_SOUND_PERMISSION=/usr/share/sounds/freedesktop/stereo/dialog-information.oga
